model CatalogService {
  id                String   @id @default(uuid())
  parentId          String?  @map("parent_id")
  name              String
  description       String?
  icon              String?
  depth             Int      @default(0)
  sortOrder         Int      @default(0) @map("sort_order")
  active            Boolean  @default(true)
  requiresStartDate Boolean  @default(false) @map("requires_start_date")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  parent        CatalogService?   @relation("CatalogHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      CatalogService[]  @relation("CatalogHierarchy")
  questions     ServiceQuestion[]
  requests      ServiceRequest[]  @relation("RequestService")
  rootedRequests ServiceRequest[] @relation("RequestServiceRoot")

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
  @@map("catalog_services")
}

model ServiceQuestion {
  id           String       @id @default(uuid())
  serviceId    String       @map("service_id")
  key          String
  label        String
  helpText     String?      @map("help_text")
  type         QuestionType
  required     Boolean      @default(false)
  sortOrder    Int          @default(0) @map("sort_order")
  active       Boolean      @default(true)
  options      Json         @default("[]")
  config       Json         @default("{}")
  dateRole     DateRole?    @map("date_role")
  sensitive    Boolean      @default(false)
  matchesSkill Boolean      @default(false) @map("matches_skill")
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  service CatalogService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@map("service_questions")
}

model ServiceRequest {
  id                    String                  @id @default(uuid())
  number                Int                     @unique @default(autoincrement())
  ownerId               String                  @map("owner_id")
  customerName          String                  @map("customer_name")
  title                 String
  service               String
  cityId                String                  @map("city_id")
  districtId            String                  @map("district_id")
  address               String
  phone                 String
  contactMethod         ContactMethod           @default(phone) @map("contact_method")
  description           String
  budget                BigInt                  @default(0)
  startDate             String?                 @map("start_date")
  details               Json                    @default("{}")
  serviceId             String?                 @map("service_id")
  serviceRootId         String?                 @map("service_root_id")
  servicePath           Json?                   @map("service_path")
  answers               Json                    @default("[]")
  status                RequestStatus           @default(submitted)
  version               Int                     @default(1)
  contactInBrief        Boolean                 @default(false) @map("contact_in_brief")
  possibleDuplicateOf   String?                 @map("possible_duplicate_of")
  intakeState           IntakeState             @default(pending) @map("intake_state")
  clarificationAskedAt  DateTime?               @map("clarification_asked_at")
  clarificationCount    Int                     @default(0) @map("clarification_count")
  intakeApprovedBy      String?                 @map("intake_approved_by")
  intakeApprovedAt      DateTime?               @map("intake_approved_at")
  offerBrief            String?                 @map("offer_brief")
  shareOnConfirm        Json                    @default("{\"description\":true,\"attachmentIds\":[]}") @map("share_on_confirm")
  staffOwnerId          String?                 @map("staff_owner_id")
  claimedAt             DateTime?               @map("claimed_at")
  unclaimedSince        DateTime?               @map("unclaimed_since")
  ownershipVersion      Int                     @default(1) @map("ownership_version")
  dispatchMode          DispatchMode            @default(auto) @map("dispatch_mode")
  autoAttempts          Int                     @default(0) @map("auto_attempts")
  needsAssignmentReason NeedsAssignmentReason?  @map("needs_assignment_reason")
  lastRunId             String?                 @map("last_run_id")
  holdKind              HoldKind?               @map("hold_kind")
  holdBy                String?                 @map("hold_by")
  holdReason            String?                 @map("hold_reason")
  holdAt                DateTime?               @map("hold_at")
  holdPreviousStatus    RequestStatus?          @map("hold_previous_status")
  issueCycles           Int                     @default(0) @map("issue_cycles")
  reportApprovedAt      DateTime?               @map("report_approved_at")
  confirmDueAt          DateTime?               @map("confirm_due_at")
  acknowledgedAt        DateTime?               @map("acknowledged_at")
  acknowledgedBy        AcknowledgedBy?          @map("acknowledged_by")
  acknowledgedNote      String?                 @map("acknowledged_note")
  defectsWindowEndsAt   DateTime?               @map("defects_window_ends_at")
  cancellationId        String?                 @map("cancellation_id")
  closedAt              DateTime?               @map("closed_at")
  closedBy              String?                 @map("closed_by")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  catalogService CatalogService? @relation("RequestService", fields: [serviceId], references: [id], onDelete: Restrict)
  catalogRoot    CatalogService? @relation("RequestServiceRoot", fields: [serviceRootId], references: [id], onDelete: Restrict)
  attachments   RequestAttachment[]
  edits         RequestEdit[]
  runs          DispatchRun[]
  assignments   Assignment[]
  contributions Contribution[]
  quotes        Quote[]
  schedules     Schedule[]
  updates       ProgressUpdate[]
  issues        Issue[]
  cancellations Cancellation[]
  noShows       NoShow[]
  messages      RequestMessage[]
  payments      Payment[]
  refunds       Refund[]
  payouts       Payout[]

  @@index([ownerId, status])
  @@index([status, intakeState])
  @@index([staffOwnerId, status])
  @@index([service, districtId, createdAt])
  @@index([serviceRootId])
  @@map("service_requests")
}

