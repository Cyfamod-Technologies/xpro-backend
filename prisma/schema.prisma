generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Application-wide role. Checked by RolesGuard via the @Roles() decorator.
enum AppRole {
  super_admin
  admin
  user
}

// Which frontend a user may sign in to. Checked by AppSurfaceGuard via
// @AppSurfaces(). Roles map to surfaces in AuthService.surfacesForRole().
enum AppSurface {
  admin
  user
}

enum AccountStatus {
  unverified
  invited
  active
  inactive
  suspended
  pending_deletion
  deactivated
  deleted
  archived
}

enum PlatformRole {
  customer
  provider
  staff
}

enum WorkspaceRole {
  customer
  provider
}

enum RoleAddedVia {
  signup
  invite
  self_service
}

enum ClientKind {
  web
  mobile_ios
  mobile_android
}

enum SessionRevokedReason {
  logout
  logout_all
  user_revoked
  admin_revoked
  password_changed
  password_reset
  email_changed
  mfa_reset
  mfa_reenrolled
  suspended
  deactivated
  deletion_requested
  role_changed
  refresh_reuse
  expired
}

enum AuthTokenPurpose {
  email_verify
  password_reset
  email_change
  mfa_challenge
  mfa_enrollment
}

enum LegalDocumentKind {
  terms
  privacy
  provider_agreement
  staff_policy
}

enum StaffRole {
  super_admin
  operations
  pricing
  client_relations
  finance
}

enum StaffStatus {
  invited
  active
  suspended
  deactivated
  revoked
}

enum StaffInviteState {
  pending
  consumed
  superseded
  revoked
  expired
}

enum ProviderVerificationStatus {
  draft
  pending
  changes_requested
  rejected
  approved
  delisted
}

enum ProviderBankStatus {
  pending
  verified
  rejected
  superseded
}

enum ProviderUploadPurpose {
  provider_document
  provider_photo
  provider_portfolio
}

enum ProviderUploadStatus {
  pending
  ready
  attached
  expired
}

enum UploadPurpose {
  request_attachment
  message_attachment
  progress_evidence
  payment_proof
}

enum UploadStatus {
  pending
  ready
  attached
  expired
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                      String        @id @default(uuid())
  email                   String        @unique
  passwordHash            String?       @map("password_hash")
  firstName               String?       @map("first_name")
  lastName                String?       @map("last_name")
  role                    AppRole       @default(user)
  status                  AccountStatus @default(invited)
  emailVerifiedAt         DateTime?     @map("email_verified_at")
  phoneE164               String?       @map("phone_e164")
  phoneVerifiedAt         DateTime?     @map("phone_verified_at")
  onboardingCompleted     Boolean       @default(false) @map("onboarding_completed")
  mfaEnabled              Boolean       @default(false) @map("mfa_enabled")
  mfaSecret               String?       @map("mfa_secret")
  lastLoginAt             DateTime?     @map("last_login_at")
  avatarUrl               String?       @map("avatar_url")
  language                String?       @default("en")
  timezone                String?
  notificationPreferences Json?         @map("notification_preferences")
  name                    String?
  statusReason            String?       @map("status_reason")
  statusChangedAt         DateTime?     @map("status_changed_at")
  statusChangedBy         String?       @map("status_changed_by")
  passwordChangedAt       DateTime?     @map("password_changed_at")
  failedLoginCount        Int           @default(0) @map("failed_login_count")
  backoffUntil            DateTime?     @map("backoff_until")
  mfaSecretEnc            Bytes?        @map("mfa_secret_enc")
  mfaPendingSecretEnc     Bytes?        @map("mfa_pending_secret_enc")
  mfaPendingCreatedAt     DateTime?     @map("mfa_pending_created_at")
  mfaEnrolledAt           DateTime?     @map("mfa_enrolled_at")
  mfaLastStep             BigInt?       @map("mfa_last_step")
  lastActiveRole          WorkspaceRole? @map("last_active_role")
  deletionRequestedAt     DateTime?     @map("deletion_requested_at")
  deletionScheduledFor    DateTime?     @map("deletion_scheduled_for")
  deletedAt               DateTime?     @map("deleted_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  auditLogs     AuditLog[]           @relation("AuditActor")
  platformRoles UserRole[]
  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes MfaRecoveryCode[]
  legalAcceptances LegalAcceptance[]
  statusHistory AccountStatusHistory[]
  staffMember   StaffMember?
  providerProfile ProviderProfile?
  providerUploads ProviderUpload[]
  phoneVerifications PhoneVerification[]

  @@map("users")
}

model PhoneVerification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  phoneE164   String    @map("phone_e164")
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([phoneE164, createdAt])
  @@map("phone_verifications")
}

model UserRole {
  userId   String       @map("user_id")
  role     PlatformRole
  addedAt  DateTime     @default(now()) @map("added_at")
  addedVia RoleAddedVia @map("added_via")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Session {
  id                    String               @id @default(uuid())
  userId                String               @map("user_id")
  client                ClientKind
  deviceId              String?              @map("device_id")
  deviceLabel           String               @map("device_label")
  ipCreated             String?              @map("ip_created") @db.Inet
  ipLast                String?              @map("ip_last") @db.Inet
  userAgent             String               @map("user_agent")
  remember              Boolean              @default(false)
  activeRole            WorkspaceRole?       @map("active_role")
  mfaVerifiedAt         DateTime?            @map("mfa_verified_at")
  reauthAt              DateTime?            @map("reauth_at")
  lastSeenAt            DateTime             @default(now()) @map("last_seen_at")
  idleExpiresAt         DateTime             @map("idle_expires_at")
  absoluteExpiresAt     DateTime             @map("absolute_expires_at")
  permissionVersionSeen Int?                 @map("permission_version_seen")
  revokedAt             DateTime?            @map("revoked_at")
  revokedReason         SessionRevokedReason? @map("revoked_reason")
  createdAt             DateTime             @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model RefreshToken {
  id            String    @id @default(uuid())
  sessionId     String    @map("session_id")
  tokenHash     Bytes     @unique @map("token_hash")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  supersededAt  DateTime? @map("superseded_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, supersededAt])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  purpose   AuthTokenPurpose
  tokenHash Bytes           @unique @map("token_hash")
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  attempts  Int             @default(0)
  metadata  Json?
  createdIp String?         @map("created_ip") @db.Inet
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  Bytes     @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model LegalDocument {
  id          String            @id @default(uuid())
  kind        LegalDocumentKind
  version     String
  url         String
  publishedAt DateTime          @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, publishedAt])
  @@map("legal_documents")
}

model LegalAcceptance {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  documentId String   @map("document_id")
  acceptedAt DateTime @default(now()) @map("accepted_at")
  source     String
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
  @@index([userId, acceptedAt])
  @@map("legal_acceptances")
}

model AccountStatusHistory {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  status    AccountStatus
  reason    String?
  changedBy String?      @map("changed_by")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("account_status_history")
}

model StaffMember {
  userId      String      @id @map("user_id")
  status      StaffStatus @default(invited)
  permVersion Int         @default(1) @map("perm_version")
  canOwnRequests Boolean  @default(false) @map("can_own_requests")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles StaffMemberRole[]
  invites StaffInvite[]

  @@map("staff_members")
}

model StaffMemberRole {
  staffUserId String    @map("staff_user_id")
  role        StaffRole
  addedAt     DateTime  @default(now()) @map("added_at")

  staffMember StaffMember @relation(fields: [staffUserId], references: [userId], onDelete: Cascade)

  @@id([staffUserId, role])
  @@index([role])
  @@map("staff_member_roles")
}

model ProviderProfile {
  id                 String                    @id @default(uuid())
  userId             String                    @unique @map("user_id")
  phone              String
  trade              String
  city               String
  state              String?
  cityId             String?                  @map("city_id")
  services           Json
  serviceAreas       Json                     @map("service_areas")
  serviceAreaIds     String[]                 @default([]) @map("service_area_ids")
  businessName       String?                  @map("business_name")
  skills             Json
  serviceIds         Json?                    @map("service_ids")
  skillIds           Json?                    @map("skill_ids")
  capacity           Int                      @default(3)
  workingHours       Json                     @map("working_hours")
  timeOff            Json                     @default("[]") @map("time_off")
  experience         Float                    @default(0)
  lastOfferedAt      DateTime?                 @map("last_offered_at")
  reliabilityStatus  String                    @default("normal") @map("reliability_status")
  bio                String
  documents          Json                     @default("[]")
  photo              Json?
  portfolio          Json                     @default("[]")
  verification       ProviderVerificationStatus @default(draft)
  available          Boolean                  @default(false)
  reviewNote         String?                  @map("review_note")
  reviewedAt         DateTime?                @map("reviewed_at")
  reviewedBy         String?                  @map("reviewed_by")
  rejectedAt         DateTime?                @map("rejected_at")
  pendingChanges     Json?                    @map("pending_changes")
  changesReview      Json?                    @map("changes_review")
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityLocation Location?     @relation("ProviderCity", fields: [cityId], references: [id], onDelete: SetNull)
  bankAccounts ProviderBankAccount[]
  reviews    ProviderReview[]
  payouts    Payout[]
  featured   FeaturedProvider?

  @@index([verification, available])
  @@map("provider_profiles")
}

enum FeaturedProviderMode {
  pinned
  hidden
}

model FeaturedProvider {
  providerId String               @id @map("provider_id")
  mode       FeaturedProviderMode
  position   Int?
  updatedBy  String               @map("updated_by")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([mode, position])
  @@map("featured_providers")
}

enum LocationKind {
  city
  district
}

model Location {
  id        String   @id @default(uuid())
  kind      LocationKind
  name      String
  parentId  String?  @map("parent_id")
  aliases   String[] @default([])
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationHierarchy")
  providers ProviderProfile[] @relation("ProviderCity")

  @@unique([parentId, name])
  @@index([kind, active])
  @@index([parentId, active, sort])
  @@map("locations")
}

model ProviderBankAccount {
  id                 String             @id @default(uuid())
  providerId         String             @map("provider_id")
  bankCode           String             @map("bank_code")
  bankName           String             @map("bank_name")
  accountNumberEnc   String             @map("account_number_enc")
  accountNameEnc     String             @map("account_name_enc")
  last4              String             @map("last4")
  recipientCodeEnc   String?            @map("recipient_code_enc")
  state              ProviderBankStatus @default(pending)
  reviewNote         String?            @map("review_note")
  reviewedBy         String?            @map("reviewed_by")
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, state])
  @@map("provider_bank_accounts")
}

model ProviderReview {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  kind       String
  decision   String
  note       String?
  actorId    String   @map("actor_id")
  version    Int
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@map("provider_reviews")
}

model ProviderReliabilityEvent {
  id          String   @id @default(uuid())
  providerId  String   @map("provider_id")
  kind        String
  requestId   String?  @map("request_id")
  sourceId    String   @unique @map("source_id")
  occurredAt  DateTime @map("occurred_at")
  confirmedBy String?  @map("confirmed_by")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([providerId, occurredAt])
  @@map("provider_reliability_events")
}

model ProviderUpload {
  id          String                 @id @default(uuid())
  ownerId     String                 @map("owner_id")
  purpose     ProviderUploadPurpose
  status      ProviderUploadStatus   @default(pending)
  fileName    String                 @map("file_name")
  contentType String                 @map("content_type")
  size        Int
  storageKey  String                 @unique @map("storage_key")
  expiresAt   DateTime               @map("expires_at")
  completedAt DateTime?              @map("completed_at")
  attachedAt  DateTime?              @map("attached_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, purpose])
  @@index([expiresAt])
  @@map("provider_uploads")
}

model Upload {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  purpose     UploadPurpose
  status      UploadStatus  @default(pending)
  fileName    String        @map("file_name")
  contentType String        @map("content_type")
  size        Int
  storageKey  String        @unique @map("storage_key")
  entityType  String?       @map("entity_type")
  entityId    String?       @map("entity_id")
  expiresAt   DateTime      @map("expires_at")
  completedAt DateTime?     @map("completed_at")
  attachedAt  DateTime?     @map("attached_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([ownerId, status, purpose])
  @@index([entityType, entityId])
  @@index([expiresAt])
  @@map("uploads")
}

model StaffInvite {
  id          String          @id @default(uuid())
  staffUserId String          @map("staff_user_id")
  tokenHash   Bytes           @unique @map("token_hash")
  state       StaffInviteState @default(pending)
  invitedBy   String          @map("invited_by")
  expiresAt   DateTime        @map("expires_at")
  consumedAt  DateTime?       @map("consumed_at")
  revokedAt   DateTime?       @map("revoked_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  staffMember StaffMember @relation(fields: [staffUserId], references: [userId], onDelete: Cascade)

  @@index([staffUserId, state])
  @@index([expiresAt])
  @@map("staff_invites")
}

// Outbound notification record. Written by NotificationsService before the
// message is queued, then updated by the queue processor once delivery is
// attempted, so every send has a durable trail independent of the queue.
model Notification {
  id              String    @id @default(uuid())
  recipientUserId String?   @map("recipient_user_id")
  recipientEmail  String    @map("recipient_email")
  channel         String    @default("email")
  templateKey     String?   @map("template_key")
  type            String
  status          String    @default("queued")
  payload         Json?
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([recipientUserId])
  @@index([type, status])
  @@map("notifications")
}

// Append-only activity log. Written asynchronously through the `audit-logs`
// queue so request latency never depends on the write.
model AuditLog {
  id         String   @id @default(uuid())
  publicId   String?  @unique @map("public_id")
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  action     String
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, action])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Dead-letter record for BullMQ jobs that exhausted their retries. Standalone
// (no relations) so a failure is never lost to a cascading delete.
model FailedJob {
  id           String    @id @default(uuid())
  queueName    String    @map("queue_name")
  jobId        String    @map("job_id")
  jobName      String    @map("job_name")
  payload      Json
  errorMessage String    @map("error_message")
  failedAt     DateTime  @default(now()) @map("failed_at")
  retriedAt    DateTime? @map("retried_at")

  @@unique([queueName, jobId])
  @@index([queueName, failedAt])
  @@map("failed_jobs")
}

model IdempotencyKey {
  actorId     String   @map("actor_id")
  key         String
  requestHash String   @map("request_hash")
  status      Int
  response    Json
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@id([actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model InAppNotification {
  id          String    @id @default(uuid())
  recipientId String    @map("recipient_id")
  event       String
  title       String
  message     String
  requestId   String?   @map("request_id")
  link        String?
  mandatory   Boolean   @default(false)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([recipientId, readAt, createdAt])
  @@map("in_app_notifications")
}

model Setting {
  key       String   @id
  value     Json
  riskClass String   @map("risk_class")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

model SettingHistory {
  id          String   @id @default(uuid())
  key         String
  oldValue    Json?    @map("old_value")
  newValue    Json     @map("new_value")
  riskClass   String   @map("risk_class")
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  reason      String
  changeSetId String   @map("change_set_id")
  sessionId   String?  @map("session_id")
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("settings_history")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  type          String
  payload       Json
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

enum TimerStatus {
  pending
  running
  done
  cancelled
  failed
}

model RequestTimer {
  id            String      @id @default(uuid())
  /// No foreign key until the requests table exists (WP-2.1).
  requestId     String      @map("request_id")
  kind          String
  /// Assignment, quote or schedule id; empty string when none.
  refId         String      @default("") @map("ref_id")
  dueAt         DateTime    @map("due_at")
  payload       Json?
  status        TimerStatus @default(pending)
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  /// Retry time after a failure, or the lease expiry while the row is running.
  nextAttemptAt DateTime?   @map("next_attempt_at")
  firedAt       DateTime?   @map("fired_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([status, dueAt])
  @@index([requestId, status])
  @@map("request_timers")
}

enum RequestStatus {
  submitted
  under_review
  matched
  quoted
  awaiting_payment
  ready_to_schedule
  scheduled
  in_progress
  blocked
  completion_pending
  acknowledged
  cancelling
  closed
  cancelled
  rejected
}

enum IntakeState {
  pending
  clarification
  approved
}

enum ContactMethod {
  email
  phone
  both
}

enum DispatchMode {
  auto
  manual
}

enum NeedsAssignmentReason {
  manual_mode
  no_eligible
  limit_reached
  declined
  expired
  acceptance_rejected
  withdrawn
  replaced
  provider_suspended
  edited
}

enum HoldKind {
  staff
  no_show
  provider_suspended
  customer_suspended
}

enum AcknowledgedBy {
  customer
  system
  staff
}

enum DispatchTrigger {
  intake_approved
  cascade
  staff_auto
  staff_view
  edited
  replace
}

enum AssignmentStatus {
  offered
  pending_approval
  accepted
  declined
  expired
  not_confirmed
  withdrawn
  replaced
  completed
}

enum AssignmentEndReason {
  declined
  expired
  acceptance_rejected
  withdrawn
  replaced
  provider_suspended
  request_edited
  request_cancelled
  request_rejected
  request_closed
}

enum AssignmentSource {
  auto
  manual
}

enum QuoteStatus {
  draft
  sent
