model GatewayEvent {
  id             String    @id @default(uuid())
  fingerprint    String    @unique
  event          String
  reference      String?
  rawBodyDigest  String    @map("raw_body_digest")
  signatureValid Boolean   @map("signature_valid")
  status         String
  /// Gateway object id the event is about (for example a refund id), so a retry can run without the raw body.
  subjectId      String?   @map("subject_id")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  /// Retry time after a failure, or the lease expiry while the row is processing.
  nextAttemptAt  DateTime? @map("next_attempt_at")
