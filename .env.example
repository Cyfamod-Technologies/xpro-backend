# ─── Identity ────────────────────────────────────────────────────────────────
# APP_NAME is the product name shown in emails and the TOTP issuer.
# SERVICE is the API name shown in Swagger and error logs.
# APP_NAME and SERVICE are set for Xpro.
APP_NAME=Xpro
SERVICE=Xpro API

NODE_ENV=development
PORT=4000

# Comma-separated allowlist. Requests from other origins are rejected.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Required to boot ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://xpro:xpro@localhost:5432/xpro_db?schema=public
JWT_SECRET=replace-me
# Must be at least 32 characters. Booting in production with this dev default
# is rejected by validateEnv().
ENCRYPTION_KEY=dev-key-not-for-production-use!!
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Sessions ────────────────────────────────────────────────────────────────
# Session lifetime in minutes. Unset falls back to the RedisAuthService default.
SESSION_DURATION_MINUTES=10080

# ─── Request body limits ─────────────────────────────────────────────────────
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb

# ─── Postgres container (docker-compose) ─────────────────────────────────────
POSTGRES_USER=xpro
POSTGRES_PASSWORD=xpro
POSTGRES_DB=xpro_db

# ─── Email — see docs/email/ ─────────────────────────────────────────────────
# ZeptoMail is the configured provider. To use SMTP (SES, Mailgun, Postmark,
# Resend, Gmail) instead, follow docs/email/smtp.md.
ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Xpro
EMAIL_REPLY_TO=
FRONTEND_URL=http://localhost:3000
EMAIL_ASSET_BASE_URL=http://localhost:3000/email/v1
EMAIL_SUPPORT_ADDRESS=support@example.com
EMAIL_PRIVACY_URL=
EMAIL_TERMS_URL=
# 1-3 character logo monogram. Derived from APP_NAME when left blank.
EMAIL_LOGO_MARK=

# ─── Object storage — see docs/storage/ ──────────────────────────────────────
# `none` (default) runs the app without object storage and skips all checks
# below. Set to `r2` and fill in the rest to enable it, then import
# StorageModule where you need it. For AWS S3, see docs/storage/s3.md.
STORAGE_DRIVER=none
STORAGE_BUCKET=
STORAGE_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public bucket URL or custom domain, e.g. https://media.example.com
STORAGE_PUBLIC_URL=

# ─── Optional alerting ───────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Seed scripts ────────────────────────────────────────────────────────────
# npm run seed:super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# npm run seed:sample-user
SAMPLE_USER_EMAIL=demo@example.com
SAMPLE_USER_PASSWORD=
SAMPLE_USER_FIRST_NAME=Alex
SAMPLE_USER_LAST_NAME=Demo
