# Example deploy workflow — rename to deploy.yml to enable.
#
# Assumes a host reachable over SSH running docker compose. Set these repo
# secrets first: SERVER_HOST, SERVER_USER, SERVER_SSH_KEY.
# Replace DEPLOY_ROOT with wherever the repo is checked out on the host.
name: Deploy

on:
  push:
    branches: [main, prod]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to EC2
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          script: |
            DEPLOY_ROOT=/var/www/app/be
            if [ "${{ github.ref_name }}" = "prod" ]; then
              DIR="$DEPLOY_ROOT/prod"
              PROJECT=app-prod
            else
              DIR="$DEPLOY_ROOT/staging"
              PROJECT=app-staging
            fi
            cd "$DIR"
            git pull origin ${{ github.ref_name }}
            docker compose -p "$PROJECT" --env-file .env.prod -f docker-compose.prod.yml up -d --build
            docker image prune -f
